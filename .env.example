# Ayurnexa - E-commerce Frontend Configuration
# Local development: copy this to .env.local.
# Production Docker deployments load these client settings from
# /opt/ayurnexfrontend/.env when the container starts.
# VITE_ values are visible to every browser user; never put server-only secrets here.

VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_KEY=your_api_key_here
VITE_APP_NAME=Ayurnexa
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# Supabase Storage Configuration (for direct image uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_BUCKET=Ayurnexa

